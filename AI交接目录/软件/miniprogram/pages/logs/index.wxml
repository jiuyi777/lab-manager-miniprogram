<view class="screen"><view class="title">操作日志</view><view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{!items.length}}" class="empty">暂无记录</view>
<view wx:for="{{items}}" wx:key="id" class="card"><view class="heading">{{item.userName}} · {{item.action}}</view><view class="muted">{{item.atText}}</view><view>{{item.targetId}}</view><view class="small">{{item.detailText}}</view></view></view>
