@import "styles/tokens.wxss";
page{background:#f6f7f4;color:#202a25;font-family:system-ui,sans-serif;font-size:30rpx;line-height:1.6}
::-webkit-scrollbar{display:none;width:0;height:0}
view,text,input,textarea,button,picker{box-sizing:border-box}
.screen{padding:30rpx 32rpx 64rpx}.title{font-size:44rpx;font-weight:600;line-height:1.3;margin:12rpx 0 16rpx}.subtitle,.muted{color:#657168;font-size:26rpx}
.card{background:#fff;border:1rpx solid #cbd3ca;border-radius:24rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 4rpx 8rpx rgba(32,42,37,.025)}
.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}
.heading{font-size:34rpx;font-weight:600}.large{font-size:40rpx;font-weight:600}.section{margin:32rpx 0 16rpx;font-size:34rpx;font-weight:600}
.pill{display:inline-block;padding:4rpx 16rpx;border-radius:30rpx;background:#dbe5da;font-size:24rpx;white-space:nowrap}.warning{background:#f0e6ca}
.notice{padding:16rpx 22rpx;border-radius:16rpx;background:#e8ede6;color:#455449;font-size:26rpx;margin:18rpx 0}
.error{background:#f7e3df;color:#864738}.line{border-top:1rpx solid #e0e5de;margin:22rpx 0}
button{margin:16rpx 0 0;font-size:29rpx;font-weight:500;line-height:1.5;padding:20rpx 22rpx;background:#202a25;color:#fff;border-radius:18rpx}
button::after{border:0}button.secondary{color:#202a25;background:#fff;border:1rpx solid #cbd3ca}button[disabled]{background:#e3e7e1;color:#6f786e}
.actions{display:flex;gap:18rpx;flex-wrap:wrap}.actions button{flex:1;min-width:160rpx}
.field{margin:22rpx 0}.label{display:block;font-size:28rpx;margin-bottom:10rpx}
input,textarea,.select{width:100%;padding:20rpx;border:1rpx solid #cbd3ca;border-radius:14rpx;background:#fff;font-size:30rpx}
input{height:86rpx}textarea{min-height:150rpx}checkbox,radio{transform:scale(.85)}.option{padding:18rpx 0;display:flex;align-items:center}
.link{padding:24rpx 0;border-bottom:1rpx solid #e0e5de}.empty{padding:50rpx 20rpx;text-align:center;color:#657168}.small{font-size:24rpx}

